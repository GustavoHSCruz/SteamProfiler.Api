# The key is only ever read by the api container. Get one at
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Whose site this is: the footer credit and the example link point here.
# Use a SteamID64, not the shorter account id. Both values are required for a
# useful instance; the defaults below point at SteamProfiler's public example.
STEAM_ID=76561198086380973
STEAM_VANITY=gordziilla

# Docker Compose binds to loopback by default. Deliberately set HTTP_BIND to
# 0.0.0.0 (normally behind a TLS reverse proxy) to accept remote traffic.
HTTP_BIND=127.0.0.1
HTTP_PORT=16200
# O front reconstruido, pre-renderizado. Opcional: sem ele o nginx serve
# as paginas antigas.
# Pasta dos bancos no host. Vazio usa o volume nomeado do compose, que e o
# certo para instalacao nova; um servidor que ja tinha ./data aponta aqui.
DATA_HOST_DIR=

FRONTEND_NEXT_DIR=

FRONTEND_DIR=../steamprofiler-front/site

# The optional admin profile is also loopback-only by default. Keep the allow
# list narrow even when a firewall or private network protects the port.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=16201
ADMIN_ALLOW_IPS=127.0.0.1,::1
PUBLIC_SITE_URL=http://127.0.0.1:16200

# How long a lookup stays fresh, in seconds. Playtime does not move faster.
CACHE_TTL=900
# How long the browser is told to hold the same answer. Shorter than CACHE_TTL
# on purpose: the service still rebuilds only every CACHE_TTL, but a reload
# right after a deploy must not be answered out of a cache the deploy did not
# reach. OWNER_TTL is the same idea for the two answers that barely change,
# the owner's own card and a resolved vanity name.
CLIENT_TTL=60
OWNER_TTL=1800
# An embed the Companion extension draws inside a Steam profile page. Shorter
# than CACHE_TTL because that card sits on somebody's profile claiming to be
# current, and because withdrawing one means waiting out every cache in front
# of it.
STEAM_EMBED_TTL=300
# Quantas requisições uma montagem fria pode ter no ar ao mesmo tempo. As dez
# chamadas do /u/ são independentes entre si, então perguntadas juntas o visitante
# espera a mais lenta e não a soma de todas. Não é dez vezes mais carga na Steam:
# é o mesmo punhado de requisições de sempre, só que em paralelo - e o orçamento
# do guard.py conta requisição, não requisição por segundo.
#
# FETCH_FANOUT=1 volta tudo a ser uma sequência, que é o que se liga quando uma
# montagem está estranha e a pergunta é se a concorrência é o motivo.
FETCH_FANOUT=10

# Hard ceiling on entries held in memory, so a stream of lookups cannot grow
# the process without bound.
CACHE_MAX=400

# Where the front end's files are, when the code is mounted read-only and the
# site lives somewhere else. Empty means ./site next to this file, which is the
# layout outside a container.
SITE_DIR=

# Token for /admin, where the messages are triaged. Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Without it /admin answers 503 and nobody can read the inbox.
ADMIN_TOKEN=

# ── The gate in front of the key ─────────────────────────────────────
# Every visitor's lookup spends the key above, so guard.py prices each request
# and holds the day's spend under a ceiling. All of these have sane defaults
# and are here to be found, not because they need setting.
#
# Calls to Steam per day, across everyone. Steam allows 100k; half of it means
# a bad day still leaves the key working tomorrow. Over the ceiling, profiles
# already read keep being served and only new ones are refused.
GUARD_BUDGET=50000
# Distinct profiles one address may look up in an hour. This is the limit that
# stops enumeration - a person reads themselves and a few friends.
GUARD_SUBJECTS=30
# The bucket, in cost-weighted tokens: the burst one address is allowed, and
# what it can keep up with per second. A dashboard is about ten units and a
# game page about six, so this is a burst of thirty pages and a sustained five
# units a second, which no person reaches and no crawler stays under.
GUARD_CAPACITY=300
GUARD_REFILL=5
# Refusals inside ten minutes before an address is shut out for GUARD_BLOCK.
GUARD_STRIKES=25
# How many cold builds may queue at once. They are serialised behind one lock,
# so a queue of a hundred is a hundred connections held open for minutes. Past
# this the answer is "busy", immediately, which is the honest one.
GUARD_WAITING=8
# Set to 0 to hold the local network to the same limits as everyone else.
GUARD_TRUST_PRIVATE=1
# How long an address that keeps overrunning the bucket is refused, in
# seconds. Backpressure, not punishment: bad faith is what GUARD_BAN below
# is for. Changing this means changing the copy on site/abuse.html and the
# Retry-After in nginx.conf too - neither can read this value.
GUARD_BLOCK=30
# How long an address that asked for /.env, /.git/config or any of the other
# credential-scan paths stays shut out, in seconds. Two days by default. This
# is the one limit that survives a restart, in data/bans.db, because a ban a
# deploy lifts is not a ban.
GUARD_BAN=172800
# An address that was let back in and gets banned again inside this window is
# flagged as a repeat: a line on stderr, a counter on /healthz, and REPEAT at
# the front of any appeal it files. Without it the appeal is a way back in that
# can be used over and over without anyone noticing.
GUARD_REOFFEND=172800
# How long a ban that no longer applies is kept, counted from when it stopped
# applying. The only reason a row outlives its own expiry, and short on purpose:
# enough to recognise a repeat, not enough to be a record of who visited.
GUARD_HISTORY=604800
# How far down the library the rarity scan reaches. Three calls per game, and
# it holds the build lock for all of them.
RARITY_GAMES=12
# How many friends the leaderboard reads. One call each, and they are calls
# about people who are not the subject of the page, so the ceiling is lower
# than the arithmetic alone would allow.
MATE_FRIENDS=20

# The storefront crawler, which reads prices and genres. One request every this
# many seconds - there is no key and no documented quota, and the reported
# ceiling is around 200 requests per five minutes.
STORE_INTERVAL=2.0
# Which store's prices. The page says which country it is quoting.
STORE_COUNTRY=br

# O leitor do Mercado da Comunidade, que descobre o conjunto de cartas de cada
# jogo e o preço de cada uma. Uma requisição a cada tantos segundos - quatro
# vezes mais devagar que a loja de propósito: é o mesmo host que serve a
# leitura dos perfis, e é a metade da Steam que responde rajada com 429.
MARKET_INTERVAL=8.0
# MARKET_OFFLINE=1 faz toda consulta ao mercado falhar na hora, do mesmo jeito
# que STORE_OFFLINE faz com a loja: é como se alcança de propósito a página de
# cartas ainda enchendo, sem esperar a Valve ter um dia ruim.
MARKET_OFFLINE=0

# ECON_PANEL=1 publica /econ, que mostra as trocas da conta dona da chave -
# ou seja, as SUAS, em qualquer perfil que alguém abrir, porque o IEconService
# não aceita steamid. Por isso a rota recusa qualquer perfil que não seja o
# STEAM_ID acima, e por isso ela nasce desligada: quase toda instalação não tem
# motivo para pôr isso numa página. Só contagens e uma data, nunca as trocas em
# si - um histórico nomeia as contas do outro lado, e essas pessoas não
# concordaram com nada.
ECON_PANEL=0

# O leitor de inventário, que descobre quais cartas um perfil já tem. Mesmo
# host do mercado e do scrape de perfil, e por isso mesmo orçamento: quem pauta
# os três é o MARKET_INTERVAL acima, não uma variável daqui.
#
# Quanto tempo um inventário lido fica na memória, em segundos. Quinze minutos,
# que é o que a política de privacidade promete para uma consulta - este não é
# um número para ajustar por desempenho: subir daqui pede que a política diga
# outra coisa primeiro. Nada disto vai para o disco.
INVENTORY_TTL=900
# Teto de itens numa leitura. Dois mil é o limite medido da Steam: com 5000 ela
# responde 400. Acima disso a resposta diz "truncada" em vez de gastar mais
# quatro intervalos de oito segundos lendo a coleção de um estranho até o fim.
INVENTORY_MAX=2000
# Quantos inventários ficam guardados ao mesmo tempo, para uma enxurrada de
# consultas não crescer o processo sem limite.
INVENTORY_CACHE=300
# INVENTORY_OFFLINE=1 faz toda leitura de inventário falhar na hora, como as
# outras três: é como se alcançam de propósito os estados "ainda não lido" e
# "inventário fechado" do painel de coleção.
INVENTORY_OFFLINE=0

# FX_OFFLINE=1 faz toda leitura de câmbio falhar na hora, como as duas de cima.
# O câmbio é uma requisição por dia, e serve só para dizer, ao lado do preço em
# dólar de um conjunto de cartas, aproximadamente quanto é na moeda de quem
# está lendo - o dólar continua sendo o número de registro. Com isto ligado a
# aproximação some da página e sobra o dólar, que é como a página fica quando a
# origem do câmbio está fora do ar. Ver fx.py.
FX_OFFLINE=0

# STORE_OFFLINE=1 faz toda consulta à loja falhar na hora. Nada em produção
# quer isso: é como se alcançam de propósito os estados degradados do bloco de
# preço (preço velho, "ainda não lido", loja fora do ar) sem esperar a Valve
# ter um dia ruim, e sem martelar a loja durante o desenvolvimento.
STORE_OFFLINE=0

# Where donations go. An empty channel is simply not shown, and a malformed one is
# dropped with a warning in the log rather than published - a wrong crypto address
# is money that does not come back.
KOFI_URL=
BTC_ADDRESS=
XMR_ADDRESS=

# ── Os dois segredos que identificam sem identificar ──────────────────
# O sal dos hashes de endereço que o quadro de recados, os votos e os bans usam.
# Ele NÃO roda: um ban que expira porque um segredo foi trocado não é um ban, e
# um voto por pessoa deixa de ser um voto por pessoa.
#
# Vazio, o store.py cai no arquivo data/ip-salt, que é onde ele ficava - e é
# justamente o problema, porque sal e banco no mesmo diretório são endereços
# reversíveis para quem tiver uma cópia dele (o espaço IPv4 tem 4 bilhões de
# endereços; refazer a tabela é questão de minutos). Preencher aqui separa as
# duas metades. Numa instalação que já rodou, o valor tem que ser exatamente o
# do arquivo: trocar não perde as linhas, órfã elas - um endereço banido deixa
# de casar com o recurso que ele abriu.
IP_SALT=
# A semente de onde o censo (census.py) deriva o sal de cada janela. Trocada
# aqui, a contagem de "é ele de novo" recomeça e nada mais acontece; é o único
# segredo deste arquivo que é seguro rodar.
#
# Vazia, cada processo gera uma efêmera e a recorrência morre em cada restart.
# Isso é de propósito: a falha aponta para inútil em vez de para um segredo
# escrito no volume de dados.
CENSUS_SEED=
# A janela do censo, em segundos. Sete dias. Uma janela maior não é um dado
# melhor: endereço é reciclado, então quanto mais longa a janela, mais um hash
# junta gente diferente e mais a mesma pessoa aparece como vários.
CENSUS_EPOCH=604800
# Com que frequência a memória do censo é escrita no disco, em segundos. Longo
# o bastante para o gate nunca esperar o SQLite, curto o bastante para um
# deploy perder minutos em vez de um dia.
CENSUS_FLUSH=60
# Um visitante de quem ninguém ouve falar por este tempo está encerrado:
# classificado, escrito e retirado da memória.
CENSUS_IDLE=1800

# ── O tradutor opcional ───────────────────────────────────────────────
# Endereço e modelos de uma instância Ollama alcançável pelo contêiner admin.
# O padrão usa o host do Docker e não é consultado até alguém pedir tradução.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=aya-expanse:8b
OLLAMA_SLUG_MODEL=qwen3:8b
# Quanto o painel espera o Ollama responder, em segundos. Um post inteiro num
# modelo de 8B leva minutos, e o padrão de biblioteca cortaria a resposta.
OLLAMA_TIMEOUT=900
